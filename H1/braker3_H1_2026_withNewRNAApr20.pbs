#!/bin/bash
#PBS -q normal
#PBS -l mem=180GB
#PBS -l walltime=48:00:00
#PBS -l ncpus=48
#PBS -l jobfs=400GB
#PBS -l wd
#PBS -l storage=scratch/xf3+gdata/xf3+gdata/xe2+gdata/fa63
#PBS -P xf3

set -euo pipefail
set -x

module load singularity

############################################
# Paths (H1 2026 updated genome)
############################################
RM_DIR="/g/data/xf3/zz3507/Output/AfterHiCProcessing/2026Updatedgenome/H1/RepeatMasker"
WORKDIR="/g/data/xf3/zz3507/Output/20260127Genome/H1/breakerWithNewRNAApr20"
BRAKER_SIF="/g/data/xf3/zz3507/app/braker3.sif"

############################################
# Auto-detect masked genome file
############################################
GENOME_MASKED="$(find "${RM_DIR}" -type f -name 'H1_2026_v1.top20.fa.masked' | head -n 1 || true)"
if [[ -z "${GENOME_MASKED}" ]]; then
  echo "ERROR: cannot find H1_2026_v1.top20.fa.masked under ${RM_DIR}" >&2
  exit 1
fi

############################################
# RNA-seq settings
############################################
RNA_LEGACY_DIR="/g/data/xf3/zz3507/RawData/ctrapeziformis_RNA/chiloglottis"
RNA_NEW_DIR="/g/data/xf3/zz3507/RawData/ctrapeziformis_RNA/trimmed_chiloglottis"
RNA_DIR="${WORKDIR}/rnaseq_sets"

RNA_LEGACY_IDS="104C_S7,104L_S19,105C_S8,105L_S20,106C_S4,106L_S16,107C_S5,107L_S17,112c_S1,129C_S10,129L_S22,141C_S1,141L_S13,142C_S2,142L_S14,143C_S3,143L_S15,147C_S9,147L_S21,148C_S6,148L_S18,151C_S11,151L_S23,175C_S12,175L_S24,4_S17"
RNA_NEW_IDS="protocorm_pooled,roots_pooled"
RNA_IDS="${RNA_LEGACY_IDS},${RNA_NEW_IDS}"

############################################
# Make sure workdir exists
############################################
mkdir -p "${WORKDIR}" "${RNA_DIR}"

############################################
# Stage RNA-seq files for BRAKER
# BRAKER expects ID.fastq(.gz) or ID_1/ID_2.fastq(.gz)
############################################
for id in ${RNA_LEGACY_IDS//,/ }; do
  if [[ -f "${RNA_LEGACY_DIR}/${id}.fastq.gz" ]]; then
    ln -sf "${RNA_LEGACY_DIR}/${id}.fastq.gz" "${RNA_DIR}/${id}.fastq.gz"
  elif [[ -f "${RNA_LEGACY_DIR}/${id}_1.fastq.gz" && -f "${RNA_LEGACY_DIR}/${id}_2.fastq.gz" ]]; then
    ln -sf "${RNA_LEGACY_DIR}/${id}_1.fastq.gz" "${RNA_DIR}/${id}_1.fastq.gz"
    ln -sf "${RNA_LEGACY_DIR}/${id}_2.fastq.gz" "${RNA_DIR}/${id}_2.fastq.gz"
  else
    echo "ERROR: missing RNA-seq files for ${id} in ${RNA_LEGACY_DIR}" >&2
    exit 1
  fi
done

for f in \
  "${RNA_NEW_DIR}/protocorm_pooled_R1.fq.gz" \
  "${RNA_NEW_DIR}/protocorm_pooled_R2.fq.gz" \
  "${RNA_NEW_DIR}/roots_pooled_R1.fq.gz" \
  "${RNA_NEW_DIR}/roots_pooled_R2.fq.gz"; do
  if [[ ! -f "${f}" ]]; then
    echo "ERROR: missing RNA-seq file ${f}" >&2
    exit 1
  fi
done

ln -sf "${RNA_NEW_DIR}/protocorm_pooled_R1.fq.gz" "${RNA_DIR}/protocorm_pooled_1.fastq.gz"
ln -sf "${RNA_NEW_DIR}/protocorm_pooled_R2.fq.gz" "${RNA_DIR}/protocorm_pooled_2.fastq.gz"
ln -sf "${RNA_NEW_DIR}/roots_pooled_R1.fq.gz" "${RNA_DIR}/roots_pooled_1.fastq.gz"
ln -sf "${RNA_NEW_DIR}/roots_pooled_R2.fq.gz" "${RNA_DIR}/roots_pooled_2.fastq.gz"

############################################
# (Optional but recommended)
# If last time failed at compleasm_to_hints, clean only that part
############################################
if [[ -f "${WORKDIR}/errors/compleasm_to_hints.stderr" ]]; then
  echo "[INFO] Found previous compleasm_to_hints.stderr -> cleaning partial compleasm outputs for retry"
  rm -rf "${WORKDIR}/compleasm_genome_out" "${WORKDIR}/compleasm_hints.gff" || true

  find "${WORKDIR}/mb_downloads" -type f \( -name "*.tmp" -o -name "*.part" -o -name "*incomplete*" \) -delete 2>/dev/null || true
fi

############################################
# Run BRAKER3 with resume
############################################
echo "=============================="
echo "BRAKER3 H1 2026 (RESUME MODE)"
echo "MASKED GENOME : ${GENOME_MASKED}"
echo "WORKDIR       : ${WORKDIR}"
echo "RNA_DIR       : ${RNA_DIR}"
echo "RNA_IDS       : ${RNA_IDS}"
echo "THREADS       : 48"
echo "BUSCO         : embryophyta_odb10"
echo "=============================="


LOG="${WORKDIR}/braker3_H1_2026_withNewRNAApr20.$(date +%Y%m%d_%H%M%S).log"

singularity exec \
  -B /g/data:/g/data \
  -B /scratch:/scratch \
  "${BRAKER_SIF}" \
  braker.pl \
    --genome="${GENOME_MASKED}" \
    --workingdir="${WORKDIR}" \
    --rnaseq_sets_ids="${RNA_IDS}" \
    --rnaseq_sets_dirs="${RNA_DIR}" \
    --threads 48 \
    --busco_lineage embryophyta_odb10 \
    --useexisting \
  &> "${LOG}"

echo "[DONE] BRAKER finished. Log: ${LOG}"
