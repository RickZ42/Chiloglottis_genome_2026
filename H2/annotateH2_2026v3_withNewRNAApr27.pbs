#!/bin/bash
#PBS -q normal
#PBS -l mem=180GB
#PBS -l walltime=48:00:00
#PBS -l ncpus=48
#PBS -l jobfs=400GB
#PBS -l wd
#PBS -l storage=scratch/xf3+gdata/xf3+gdata/xe2+gdata/fa63
#PBS -P xf3

set -euo pipefail
set -x

module load singularity

############################################
# Paths (H2 2026 updated genome)
############################################
RM_DIR="/g/data/xf3/zz3507/Output/20260127Genome/H2/RepeatMasker"
WORKDIR="/g/data/xf3/zz3507/Output/20260127Genome/H2/breaker_H2_newRNAProtApr27"
BRAKER_SIF="/g/data/xf3/zz3507/app/braker3.2026.sif"
SPECIES="H2_2026_newRNAApr27"
AUGUSTUS_CONFIG_BASE="/g/data/xf3/zz3507/augustus_config"
AUGUSTUS_CONFIG_PATH="${AUGUSTUS_CONFIG_BASE}/${SPECIES}"

############################################
# Auto-detect masked genome file
############################################
GENOME_MASKED="$(ls -1 ${RM_DIR}/*.masked 2>/dev/null | head -n 1 || true)"
if [[ -z "${GENOME_MASKED}" ]]; then
  echo "ERROR: cannot find masked genome (*.masked) in ${RM_DIR}" >&2
  exit 1
fi

############################################
# Protein hints
############################################
PROT_SEQ="/g/data/xf3/zz3507/RawData/OrchidProteins/merged_proteins_orchid.faa"
if [[ ! -s "${PROT_SEQ}" ]]; then
  echo "ERROR: protein fasta not found or empty: ${PROT_SEQ}" >&2
  exit 1
fi

############################################
# RNA-seq settings
############################################
RNA_SOURCE_DIR="/g/data/xf3/zz3507/RawData/ctrapeziformis_RNA/trimmed_chiloglottis"
RNA_STAGE_DIR="${WORKDIR}/rnaseq_sets"

RNA_BASE_IDS="129_S120,130_S121,131_S122,104C_S7,104L_S19,105C_S8,106C_S4,106L_S16,107C_S5,112c_S1,129L_S22,141L_S13,142C_S2,142L_S14,151C_S11,151L_S23,175C_S12,175L_S24,4_S17"
RNA_NEW_IDS="protocorm_pooled,roots_pooled"
RNA_IDS="${RNA_BASE_IDS},${RNA_NEW_IDS}"

############################################
# Make sure workdir exists
############################################
mkdir -p "${WORKDIR}"
mkdir -p "${AUGUSTUS_CONFIG_PATH}"
mkdir -p "${AUGUSTUS_CONFIG_PATH}/species"
mkdir -p "${RNA_STAGE_DIR}"
[[ -d "${WORKDIR}/mb_downloads" ]] || cp -a /g/data/xf3/zz3507/database/lineage/mb_downloads "${WORKDIR}/"

# Ensure AUGUSTUS config template exists in AUGUSTUS_CONFIG_PATH
if [[ ! -f "${AUGUSTUS_CONFIG_PATH}/species/generic/generic_parameters.cfg" ]]; then
  if [[ -d /home/106/zz3507/.augustus/species/generic ]]; then
    cp -a /home/106/zz3507/.augustus/. "${AUGUSTUS_CONFIG_PATH}/"
  else
    singularity exec -B /g/data:/g/data -B /scratch:/scratch "${BRAKER_SIF}" \
      /bin/bash -c "cp -a /opt/Augustus/config/. ${AUGUSTUS_CONFIG_PATH}/"
  fi
fi

# Ensure AUGUSTUS uses a writable config path inside Singularity
export AUGUSTUS_CONFIG_PATH
export SINGULARITYENV_AUGUSTUS_CONFIG_PATH="${AUGUSTUS_CONFIG_PATH}"

############################################
# Stage RNA-seq files for BRAKER
# BRAKER expects ID.fastq(.gz) or ID_1/ID_2.fastq(.gz)
############################################
for id in ${RNA_BASE_IDS//,/ }; do
  if [[ -f "${RNA_SOURCE_DIR}/${id}.fastq.gz" ]]; then
    ln -sf "${RNA_SOURCE_DIR}/${id}.fastq.gz" "${RNA_STAGE_DIR}/${id}.fastq.gz"
  elif [[ -f "${RNA_SOURCE_DIR}/${id}_1.fastq.gz" && -f "${RNA_SOURCE_DIR}/${id}_2.fastq.gz" ]]; then
    ln -sf "${RNA_SOURCE_DIR}/${id}_1.fastq.gz" "${RNA_STAGE_DIR}/${id}_1.fastq.gz"
    ln -sf "${RNA_SOURCE_DIR}/${id}_2.fastq.gz" "${RNA_STAGE_DIR}/${id}_2.fastq.gz"
  else
    echo "ERROR: missing RNA-seq files for ${id} in ${RNA_SOURCE_DIR}" >&2
    exit 1
  fi
done

for f in \
  "${RNA_SOURCE_DIR}/protocorm_pooled_R1.fq.gz" \
  "${RNA_SOURCE_DIR}/protocorm_pooled_R2.fq.gz" \
  "${RNA_SOURCE_DIR}/roots_pooled_R1.fq.gz" \
  "${RNA_SOURCE_DIR}/roots_pooled_R2.fq.gz"; do
  if [[ ! -f "${f}" ]]; then
    echo "ERROR: missing RNA-seq file ${f}" >&2
    exit 1
  fi
done

ln -sf "${RNA_SOURCE_DIR}/protocorm_pooled_R1.fq.gz" "${RNA_STAGE_DIR}/protocorm_pooled_1.fastq.gz"
ln -sf "${RNA_SOURCE_DIR}/protocorm_pooled_R2.fq.gz" "${RNA_STAGE_DIR}/protocorm_pooled_2.fastq.gz"
ln -sf "${RNA_SOURCE_DIR}/roots_pooled_R1.fq.gz" "${RNA_STAGE_DIR}/roots_pooled_1.fastq.gz"
ln -sf "${RNA_SOURCE_DIR}/roots_pooled_R2.fq.gz" "${RNA_STAGE_DIR}/roots_pooled_2.fastq.gz"

############################################
# (Optional but recommended)
# If last time failed at compleasm_to_hints, clean only that part
############################################
if [[ -f "${WORKDIR}/errors/compleasm_to_hints.stderr" ]]; then
  echo "[INFO] Found previous compleasm_to_hints.stderr -> cleaning partial compleasm outputs for retry"
  rm -rf "${WORKDIR}/compleasm_genome_out" "${WORKDIR}/compleasm_hints.gff" || true

  find "${WORKDIR}/mb_downloads" -type f \( -name "*.tmp" -o -name "*.part" -o -name "*incomplete*" \) -delete 2>/dev/null || true
fi

############################################
# Run BRAKER3 in a new working directory/species
############################################
echo "=============================="
echo "BRAKER3 H2 2026 (ETP + new RNA)"
echo "MASKED GENOME : ${GENOME_MASKED}"
echo "WORKDIR       : ${WORKDIR}"
echo "RNA_STAGE_DIR : ${RNA_STAGE_DIR}"
echo "RNA_IDS       : ${RNA_IDS}"
echo "PROT_SEQ      : ${PROT_SEQ}"
echo "SPECIES       : ${SPECIES}"
echo "THREADS       : 48"
echo "BUSCO         : embryophyta_odb10"
echo "=============================="

LOG="${WORKDIR}/braker3_H2_2026.trimmedRNA_prot_newRNA.$(date +%Y%m%d_%H%M%S).log"

singularity exec \
  -B /g/data:/g/data \
  -B /scratch:/scratch \
  "${BRAKER_SIF}" \
  braker.pl \
    --genome="${GENOME_MASKED}" \
    --workingdir="${WORKDIR}" \
    --prot_seq="${PROT_SEQ}" \
    --species="${SPECIES}" \
    --rnaseq_sets_ids="${RNA_IDS}" \
    --rnaseq_sets_dirs="${RNA_STAGE_DIR}" \
    --threads 48 \
    --busco_lineage embryophyta_odb10 \
  &> "${LOG}"

echo "[DONE] BRAKER finished. Log: ${LOG}"
